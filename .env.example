# Copy this file to .env.local (never commit real values) and fill in your own project.
# Supabase dashboard > Project Settings > API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Use the "anon" / publishable key ONLY. Never put the service_role key in a VITE_ variable.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional: alerts when the app is closed (see README, "Alerts when the app is closed"). Public key only.
VITE_VAPID_PUBLIC_KEY=
